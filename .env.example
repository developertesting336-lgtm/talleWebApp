# Copy to .env.local for local work. On Vercel, set these under
# Project Settings > Environment Variables.

# Contact form (Resend). Without RESEND_API_KEY, submissions are only logged on the server.
RESEND_API_KEY=
CONTACT_TO=contact@talleeknows.com
CONTACT_FROM=

# Google Analytics 4 measurement ID, like G-ABC123XYZ. Leave empty to turn tracking off.
NEXT_PUBLIC_GA_ID=

# Backend API base URL for blog requests (GET /blogs, POST /blogs)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
